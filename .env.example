# LLM (required for task extraction)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Fathom (can also be set via Settings UI)
FATHOM_API_KEY=

# Jira (can also be set via Settings UI)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Backend
DATABASE_URL=sqlite:///./data/ticket_generator.db
CORS_ORIGINS=http://localhost:5173
